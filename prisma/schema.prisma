generator client {
  provider = "prisma-client-js"
  // Remove or comment out any custom output path
  // output = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model books {
  bookId     BigInt       @id @default(autoincrement())
  bookcaseId BigInt
  surname    String
  name       String
  title      String
  year       Int
  isbn       String
  deleted    Boolean   @default(false)
}
