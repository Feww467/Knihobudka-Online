generator client {
  provider = "prisma-client-js"
  // Remove or comment out any custom output path
  // output = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
model books {
  bookId     Int       @id @default(autoincrement())
  shelfId    Int
  surname    String
  name       String
  title      String
  year       String
  isbn       String
  deleted    Boolean   @default(false)
}
model bookshelfs {
  shelfId    Int       @id @default(autoincrement())
  osmId      String
  ownerMail  String
  capacity   Int
  occupancy  Int
  deleted    Boolean   @default(false)
}
